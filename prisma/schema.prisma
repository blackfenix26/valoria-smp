generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  username     String     @unique
  email        String     @unique
  passwordHash String
  role         String     @default("USER")
  active       Boolean    @default(true)
  credits      Float      @default(0)
  createdAt    DateTime   @default(now())
  orders       Order[]
  reviews      Review[]
  serverReviews ServerReview[]
  tickets      Ticket[]
  logs         AdminLog[]
  updates      Update[]
  suggestions  AdminSuggestion[]
  applications JobApplication[]
}

model Category {
  id      String    @id @default(cuid())
  name    String    @unique
  products Product[]
}

model Product {
  id           String      @id @default(cuid())
  name         String
  description  String
  image        String
  price        Float
  promoPrice   Float?
  stock        Int         @default(-1)
  active       Boolean     @default(true)
  featured     Boolean     @default(false)
  deliveryType String      @default("DOWNLOAD")
  deliveryInfo String?
  gallery      String?
  sections     String?
  videoDemo    String?
  vipOrder     Int         @default(0)
  vipBenefits  String?
  createdAt    DateTime    @default(now())
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])
  reviews      Review[]
  items        OrderItem[]
}

model Order {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id])
  total            Float
  status           String      @default("PENDING")
  payment          String?
  paymentStatus    String      @default("PENDING")
  paymentReference String?
  paymentQrCode    String?
  pixCode          String?
  paidAt           DateTime?
  deliveryCode     String?
  deliveryUrl      String?
  createdAt        DateTime    @default(now())
  items            OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  realmId   String?
  realm     Realm?  @relation(fields: [realmId], references: [id], onDelete: SetNull)
  quantity  Int     @default(1)
  price     Float
  redemptionCodes RedemptionCode[]
}

model RedemptionCode {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  code        String    @unique
  redeemedAt  DateTime?
  redeemedBy  String?
  createdAt   DateTime  @default(now())

  @@index([orderItemId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  stars     Int
  comment   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model ServerReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  stars     Int
  comment   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model Update {
  id        String   @id @default(cuid())
  title     String
  summary   String
  content   String
  image     String?
  category  String
  status    String   @default("DRAFT")
  publishAt DateTime @default(now())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  name        String
  image       String?
  description String
  startsAt    DateTime
  endsAt      DateTime
  link        String?
  active      Boolean  @default(true)
}

model Banner {
  id          String  @id @default(cuid())
  title       String
  description String
  image       String?
  buttonText  String?
  link        String?
  active      Boolean @default(true)
}

model Ticket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  subject   String
  category  String
  message   String
  reply     String?
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
}

model Coupon {
  id     String  @id @default(cuid())
  code   String  @unique
  percent Int
  active Boolean @default(true)
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  action    String
  target    String
  createdAt DateTime @default(now())
}

model AdminSuggestion {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  title       String
  description String
  priority    String   @default("NORMAL")
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  key   String @id
  value String
}

model Realm {
  id           String   @id @default(cuid())
  name         String   @unique
  leader       String
  leaderEmail  String?
  description  String
  color        String   @default("#64748b")
  logo         String?
  banner       String?
  story        String?
  specialties  String?
  gallery      String?
  videoUrl     String?
  commerce     String?
  news         String?
  alliances    String?
  premium      Boolean  @default(false)
  featured     Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orderItems   OrderItem[]
}

model WorkOpportunity {
  id                String   @id @default(cuid())
  category          String
  title             String
  description       String
  requirements      String
  responsibilities String
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  applications      JobApplication[]
}

model JobApplication {
  id            String   @id @default(cuid())
  opportunityId String
  opportunity   WorkOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  message       String
  contact       String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
}

model WikiArticle {
  id        String   @id @default(cuid())
  title     String
  category  String
  summary   String
  content   String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FAQItem {
  id        String   @id @default(cuid())
  category  String
  question  String
  answer    String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
